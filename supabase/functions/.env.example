# 复制为 .env 后填写（勿提交 .env）
# 云端部署时平台会注入 SUPABASE_URL、SUPABASE_ANON_KEY。
# 本地 `npm run supabase:functions:serve` 时请在下方两行填写与根目录 VITE_* 相同的云端项目地址与 anon key（否则函数无法查库）。
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# deepseek = 云端 DeepSeek（默认） | ollama = 本地或自托管 Ollama
CHAT_PROVIDER=deepseek

# ========== DeepSeek（CHAT_PROVIDER=deepseek，云端部署常用）==========
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ========== Ollama（CHAT_PROVIDER=ollama）==========
# Docker 内访问 Windows/Mac 本机 Ollama（默认端口 11434）：
OLLAMA_BASE_URL=http://host.docker.internal:11434/api
OLLAMA_MODEL=gemma4:e2b
# 本机 Ollama 通常留空；仅 Ollama Cloud 时填写
OLLAMA_API_KEY=
